---
/* N7 · Brutal slab: heavy full-width bar, thick rule, lowercase link row, filled CTA.
 * No wordmark: the hero heading right below already carries the name. */
interface Props {
  links?: { label: string; href: string }[];
}

const { links = [] } = Astro.props;
---

<header class="slab">
  <div class="slab__inner wrap">
    {
      links.length > 0 && (
        <nav class="slab__nav" aria-label="Primary">
          <ul>
            {links.map((link) => (
              <li>
                <a class="nowrap" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <a class="cta-fill slab__cta" href="#contact">contact</a>
  </div>
</header>

<style>
  .slab {
    border-bottom: var(--rule-thick) solid var(--color-rule);
  }

  .slab__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-sm);
  }

  .slab__nav {
    display: none;
    margin-left: auto;
  }

  .slab__nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
  }

  .slab__nav a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
  }

  .slab__nav a:hover {
    text-decoration-line: underline;
  }

  .slab__cta {
    margin-left: auto;
    padding: var(--space-xs) var(--space-md);
  }

  @media (min-width: 48rem) {
    .slab__nav {
      display: block;
    }
  }
</style>
