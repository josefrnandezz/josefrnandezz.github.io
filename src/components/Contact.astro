---
/* Contact band: the one place colour fills the view. It enters as an inset
 * card and opens to full bleed as you scroll into it.
 * linkedin / github / x are the featured links, same weight, in that order. */
import type { SocialLink } from '../data/profile';

interface Props {
  location: string;
  socials: SocialLink[];
}

const { location, socials } = Astro.props;
const links = socials.filter((s): s is Required<SocialLink> => Boolean(s.url));
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__inner wrap">
    <h2 id="contact-title" class="contact__title"><span aria-hidden="true">👋</span> wanna get in touch?</h2>
    <ul class="contact__feature">
      {
        links.map((link) => (
          <li>
            <a href={link.url} rel="me">
              {link.label.toLowerCase()}
              <span class="arrow arrow--out" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="contact__meta">
      <p class="nowrap mono">{location.toLowerCase()}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    margin-top: clamp(var(--space-xl), 10vw, var(--space-3xl));
    background: var(--color-band);
    color: var(--color-on-band);
  }

  .contact ::selection {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .contact__inner {
    display: grid;
    gap: clamp(var(--space-md), 3.5vw, var(--space-xl));
    padding-block: clamp(var(--space-2xl), 12vw, 9rem) clamp(var(--space-lg), 5vw, var(--space-xl));
  }

  /* One line, always. The size is driven by vw so the ratio between the text
     width and the viewport stays constant — it fits at every width or none. */
  .contact__title {
    font-size: var(--text-statement);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .contact__feature {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) clamp(var(--space-md), 4vw, var(--space-2xl));
  }

  /* Fluid alongside the title so the links never out-shout the heading. */
  .contact__feature a {
    font-family: var(--font-display);
    font-size: clamp(var(--text-base), 4.7vw, var(--text-xl));
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration-color: color-mix(in oklch, var(--color-on-band) 40%, transparent);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.16em;
  }

  .contact__feature a:hover,
  .contact__feature a:active {
    color: var(--color-on-band);
    text-decoration-color: var(--color-accent);
  }

  .contact__feature .arrow {
    color: var(--color-accent);
  }

  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: clamp(var(--space-lg), 8vw, var(--space-3xl));
    padding-top: var(--space-sm);
    border-top: var(--rule-thin) solid color-mix(in oklch, var(--color-on-band) 25%, transparent);
  }

  .contact :focus-visible {
    outline-color: var(--color-on-band);
  }

  @keyframes open {
    from {
      clip-path: inset(18% var(--page-gutter) 0 var(--page-gutter) round 1.5rem 1.5rem 0 0);
    }

    to {
      clip-path: inset(0 0 0 0 round 0);
    }
  }

  @keyframes lift {
    from {
      opacity: 0;
      translate: 0 3rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .contact {
        animation: open linear both;
        animation-timeline: var(--tl-view);
        animation-range: entry 0% entry 85%;
      }

      .contact__title,
      .contact__feature {
        animation: lift linear both;
        animation-timeline: var(--tl-view);
      }

      .contact__title {
        animation-range: entry 20% entry 120%;
      }

      .contact__feature {
        animation-range: entry 60% entry 160%;
      }
    }
  }
</style>
