---
/* Contact band: full-bleed second-ink block. The one place colour fills the view. */
import type { SocialLink } from '../data/profile';

interface Props {
  email: string;
  location: string;
  socials: SocialLink[];
}

const { email, location, socials } = Astro.props;
const links = socials.filter((s): s is Required<SocialLink> => Boolean(s.url));
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__inner wrap">
    <h2 id="contact-title" class="contact__title">building something?</h2>
    <a class="contact__email" href={`mailto:${email}`}>{email}</a>
    <div class="contact__meta">
      <ul class="contact__links">
        {
          links.map((link) => (
            <li>
              <a class="nowrap" href={link.url} rel="me">
                {link.label.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="nowrap mono">{location.toLowerCase()}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: var(--space-3xl);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .contact__inner {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .contact__title {
    font-size: var(--text-statement);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: lowercase;
    max-width: 14ch;
  }

  .contact__email {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--text-email);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-decoration-color: var(--color-on-accent);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .contact__email:hover,
  .contact__email:active {
    color: var(--color-on-accent);
    text-decoration-color: var(--color-accent-2);
  }

  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm) var(--space-xl);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: var(--rule-thin) solid var(--color-on-accent);
  }

  .contact__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .contact a {
    text-decoration-color: var(--color-on-accent);
  }

  .contact a:hover {
    text-decoration-color: var(--color-accent-2);
  }

  .contact :focus-visible {
    outline-color: var(--color-on-accent);
  }
</style>
