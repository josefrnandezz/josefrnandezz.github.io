---
import type { Talk } from '../data/profile';

interface Props {
  talks: Talk[];
}

const { talks } = Astro.props;
---

<ul class="talks">
  {
    talks.map((talk) => (
      <li class="row">
        <p class="row__label">{talk.year}</p>
        <div class="row__body">
          <p class="talks__event">Speaker · {talk.event}</p>
          <p>{talk.title}</p>
          {
            talk.slidesUrl && (
              <a class="talks__slides" href={talk.slidesUrl} target="_blank" rel="noopener noreferrer">
                slides →
              </a>
            )
          }
        </div>
      </li>
    ))
  }
</ul>

<style>
  .talks {
    list-style: none;
  }

  .talks__event {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.3;
  }

  .talks__slides {
    display: inline-block;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .talks__slides:hover,
  .talks__slides:active {
    color: var(--color-accent);
    text-decoration-color: var(--color-ink);
  }
</style>
