---
import type { Talk } from '../data/profile';

interface Props {
  talks: Talk[];
}

const { talks } = Astro.props;
---

<ul class="talks">
  {
    talks.map((talk) => (
      <li class="row">
        <p class="row__label">
          {talk.year} · {talk.event}
        </p>
        <div class="row__body">
          <h3 class="talks__title">{talk.title}</h3>
          {talk.slidesUrl && (
            <a class="talks__slides" href={talk.slidesUrl} target="_blank" rel="noopener noreferrer">
              slides <span class="arrow arrow--out" aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .talks {
    list-style: none;
  }

  .talks__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .talks__slides {
    display: inline-block;
    margin-top: var(--space-sm);
    padding-block: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration-color: var(--color-accent);
  }

  .talks__slides .arrow {
    color: var(--color-accent);
  }
</style>
