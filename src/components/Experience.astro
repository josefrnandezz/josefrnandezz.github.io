---
import type { Role } from '../data/profile';
import mercadonaTech from '../assets/logos/mercadona-tech.png';
import qualifyze from '../assets/logos/qualifyze.png';
import genially from '../assets/logos/genially.svg';

interface Props {
  roles: Role[];
}

const { roles } = Astro.props;

const logos: Record<string, ImageMetadata | string | undefined> = {
  'Mercadona Tech': mercadonaTech,
  Qualifyze: qualifyze,
  Genially: genially,
};

/** A company without a logo in the map simply renders its name. */
function logoSrc(company: string): string | undefined {
  const logo = logos[company];
  return typeof logo === 'string' ? logo : logo?.src;
}
---

<ol class="roles">
  {
    roles.map((role) => (
      <li class="row">
        <p class="row__label">
          {role.start} – {role.end}
        </p>
        <div class="row__body">
          <h3 class="role">{role.title}</h3>
          <a class="company" href={role.companyUrl} target="_blank" rel="noopener noreferrer">
            {logoSrc(role.company) && (
              <img src={logoSrc(role.company)} alt="" width="20" height="20" loading="lazy" />
            )}
            {role.company}
            <span class="arrow arrow--out" aria-hidden="true">
              ↗
            </span>
          </a>
          <ul class="bullets">
            {role.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          {role.stack && (
            <ul class="stack" aria-label="Stack">
              {role.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .roles {
    list-style: none;
  }

  .role {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* Mark + name are one link, so the target is the whole line, not a 20px icon. */
  .company {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    padding-block: var(--space-2xs);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
  }

  .company:hover,
  .company:focus-visible {
    color: var(--color-ink);
  }

  .company img {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  /* Dark marks (a black glyph on transparent) vanish on dark paper: give
     every mark a light chip to sit on. */
  @media (prefers-color-scheme: dark) {
    .company img {
      background: var(--color-ink);
      padding: 2px;
      border-radius: 3px;
    }
  }

  .company .arrow {
    opacity: 0;
    transition:
      opacity 240ms var(--ease-out),
      translate 320ms var(--ease-out);
  }

  .company:hover .arrow,
  .company:focus-visible .arrow {
    opacity: 1;
  }

  .bullets {
    list-style: none;
    margin-top: var(--space-sm);
    display: grid;
    gap: var(--space-xs);
    text-wrap: pretty;
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .company .arrow {
      transition: none;
    }
  }
</style>
