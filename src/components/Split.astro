---
/* Section module: a sticky heading column and a body column. */
interface Props {
  id: string;
  title: string;
  note?: string;
  reverse?: boolean;
}

const { id, title, note, reverse = false } = Astro.props;
---

<section class:list={['split', 'wrap', { 'split--rev': reverse }]} aria-labelledby={id}>
  <div class="split__head reveal">
    <h2 id={id}>{title}</h2>
    {note && <p class="split__note muted">{note}</p>}
    <slot name="aside" />
  </div>
  <div class="split__body">
    <slot />
  </div>
</section>

<style>
  .split {
    display: grid;
    gap: var(--space-lg) var(--space-2xl);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .split__head h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: lowercase;
  }

  .split__note {
    margin-top: var(--space-sm);
    max-width: 28ch;
  }

  .split__head > :global(*:nth-child(n + 2)) {
    margin-top: var(--space-lg);
  }

  .split__body {
    min-width: 0;
  }

  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      padding-block: var(--space-3xl) var(--space-2xl);
    }

    .split--rev {
      grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
    }

    .split--rev .split__head {
      order: 2;
    }

    .split__head {
      position: sticky;
      top: calc(var(--nav-h) + var(--space-xl));
      align-self: start;
    }
  }
</style>
