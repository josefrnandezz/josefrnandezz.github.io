---
/* Type-only hero: the name fills the column, one word per line, with the
 * lede and CTA on a single row under it. No image.
 *
 * Motion: on load each word rises out of its own line mask, then the lede
 * and CTA follow. On scroll the lines slide apart in opposite directions as
 * the hero leaves the viewport. */
interface Props {
  name: string;
  lede: string;
}

const { name, lede } = Astro.props;

/* One word per line, at every width. */
const words = name.split(' ');
---

<section class="hero wrap">
  <h1 class="hero__name">
    {
      words.map((word, i) => (
        <span class="hero__line">
          {/* Trailing space keeps the words separate in the accessible name;
              it collapses visually at the end of each line. */}
          <span class:list={['hero__word', { 'hero__word--accent': i === 0 }]} style={`--i:${i}`}>
            {word}{' '}
          </span>
        </span>
      ))
    }
  </h1>

  <div class="hero__foot">
    <p class="hero__lede">{lede}</p>
    <a class="cta-fill hero__cta" href="#contact">
      say hello <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-content: end;
    gap: clamp(var(--space-lg), 4vw, var(--space-xl));
    min-height: 78svh;
    padding-block: var(--space-xl);
    view-timeline: --hero block;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: calc(100svh - var(--nav-h));
    }
  }

  /* Sized so the longest word spans the column: the divisor is that word's
     width in em at this weight and tracking, with a little air. Capped by
     the viewport height so three lines always fit above the fold. */
  .hero__name {
    font-size: min(calc((100vw - 2 * var(--page-gutter)) / 4.8), 19svh, 15.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }

  /* Each line is a mask the word rises through. The padding gives accents
     and descenders room inside the clip; the negative margin takes it back. */
  .hero__line {
    display: block;
    overflow: clip;
    padding-block: 0.12em;
    margin-block: -0.22em;
    /* Optical alignment: the heavy lowercase glyphs carry a side bearing. */
    margin-inline-start: -0.04em;
  }

  .hero__line:first-child {
    margin-top: -0.12em;
  }

  .hero__line:last-child {
    margin-bottom: -0.12em;
  }

  .hero__word {
    display: inline-block;
  }

  .hero__word--accent {
    color: var(--color-accent);
  }

  .hero__foot {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
    padding-top: var(--space-lg);
    border-top: var(--rule-thin) solid var(--color-line);
  }

  @media (min-width: 48rem) {
    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-2xl);
    }
  }

  .hero__lede {
    font-size: var(--text-md);
    line-height: 1.4;
    max-width: 36ch;
    text-wrap: pretty;
  }

  @keyframes part-left {
    to {
      translate: -9vw 0;
      opacity: 0.15;
    }
  }

  @keyframes part-right {
    to {
      translate: 9vw 0;
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__word {
      animation: rise var(--dur-enter) var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms + 80ms);
    }

    .hero__lede {
      animation: fade-up 900ms var(--ease-out) 560ms both;
    }

    .hero__cta {
      animation: fade-up 900ms var(--ease-out) 680ms both;
    }

    @supports (animation-timeline: view()) {
      .hero__line {
        animation: part-left linear both;
        animation-timeline: var(--tl-hero);
        animation-range: exit 0% exit 90%;
      }

      .hero__line:nth-child(even) {
        animation-name: part-right;
      }
    }
  }
</style>
