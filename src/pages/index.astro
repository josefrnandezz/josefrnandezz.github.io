---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Split from '../components/Split.astro';
import Experience from '../components/Experience.astro';
import Talks from '../components/Talks.astro';
import Writing from '../components/Writing.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const navLinks = [
  { label: 'about', href: '#about' },
  { label: 'experience', href: '#experience' },
  { label: 'talks', href: '#talks' },
  ...(posts.length > 0 ? [{ label: 'writing', href: '#writing' }] : []),
];
---

<Base title={`${profile.name} · ${profile.role}`} description={profile.description}>
  <Nav links={navLinks} />

  <main id="main">
    <Hero name={profile.name} lede={profile.about.lede} />

    <Split id="about" title="about">
      {/* The inner span is the single inline box the reading-ink effect fills. */}
      <p class="about ink"><span>{profile.about.body}</span></p>
    </Split>

    <Split id="experience" title="experience">
      <Experience roles={profile.experience} />
    </Split>

    <Split id="talks" title="talks">
      <Talks talks={profile.talks} />
    </Split>

    <Writing posts={posts} />
  </main>

  <Contact location={profile.location} socials={profile.socials} />
  <Footer name={profile.name} />
</Base>

<style>
  .about {
    font-family: var(--font-display);
    font-size: var(--text-lede);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.025em;
    max-width: 30ch;
    text-wrap: pretty;
  }
</style>
